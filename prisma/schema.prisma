// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum LoanPurpose {
  PERSONAL
  HOME
  AUTO
  BUSINESS
  EDUCATION
}

enum ApplicationStatus {
  PENDING
  AI_REVIEWED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  BUSINESS
  UNEMPLOYED
  STUDENT
  RETIRED
}

enum DocumentType {
  NID
  PASSPORT
  BANK_STATEMENT
  SALARY_SLIP
  UTILITY_BILL
}

enum AuditAction {
  LOGIN
  LOGOUT

  CREATE_APPLICATION
  UPDATE_APPLICATION

  UPLOAD_DOCUMENT

  GENERATE_AI_RESULT

  APPROVE_APPLICATION
  REJECT_APPLICATION
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  phone            String?
  role             UserRole          @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  loanApplications LoanApplication[]
  auditLogs        AuditLog[]

  accounts Account[]
  sessions Session[]
}

model LoanApplication {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanAmount       Decimal            @db.Decimal(12, 2)
  loanPurpose      LoanPurpose
  loanTermMonths   Int
  status           ApplicationStatus  @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employment       Employment?
  financialProfile FinancialProfile?
  documents        UploadedDocument[]
  aiPrediction     AIPrediction?
  loanDecision     LoanDecision?

  @@index([userId])
}

model Employment {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  application     LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employmentType  EmploymentType
  companyName     String?
  jobTitle        String?
  employmentYears Int
  monthlySalary   Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model FinancialProfile {
  id                 String          @id @default(cuid())
  applicationId      String          @unique
  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creditScore        Int?
  existingLoanAmount Decimal         @default(0) @db.Decimal(12, 2)
  monthlyExpense     Decimal         @db.Decimal(12, 2)
  otherIncome        Decimal         @default(0) @db.Decimal(12, 2)
  bankBalance        Decimal?        @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model UploadedDocument {
  id            String          @id @default(cuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DocumentType
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

model AIPrediction {
  id                String          @id @default(cuid())
  applicationId     String          @unique
  application       LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eligible          Boolean
  riskScore         Int
  confidenceScore   Int
  recommendedAmount Decimal         @db.Decimal(12, 2)
  reasoning         String
  
  creditAssessment  String?
  affordability       String?
  employmentRisk      String?
  savingsStrength     String?
  debtRatio           String?
  
  createdAt         DateTime        @default(now())
}

model LoanDecision {
  id             String          @id @default(cuid())
  applicationId  String          @unique
  application    LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approved       Boolean
  approvedAmount Decimal?        @db.Decimal(12, 2)
  interestRate   Decimal?        @db.Decimal(5, 2)
  remarks        String?
  reviewedAt     DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action AuditAction

  entity String

  entityId String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique

  createdAt DateTime
  updatedAt DateTime

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id String @id

  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope   String?
  idToken String?

  password String?

  createdAt DateTime
  updatedAt DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id String @id

  identifier String
  value      String

  expiresAt DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@map("verification")
}
